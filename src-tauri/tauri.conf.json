{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Visual Bar Timer",
  "version": "1.0.0",
  "identifier": "local.yone.visual-bar-timer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Visual Bar Timer",
        "width": 720,
        "height": 272,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
